APP_NAME=Threads Tool
ENVIRONMENT=dev

# --- MongoDB ---
# docker-compose: dùng service name "mongo". Chạy local (không compose): đổi sang localhost.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=threads_tool

# --- JWT ---
JWT_SECRET=whateverwillbe,willbe
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Token encryption (Fernet) ---
# Sinh key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=lT41fyHHkajXNsBBaxauzU34PH0XmAfgqnE0L6LEJJc=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media
# URL công khai để Threads API tự fetch media (bắt buộc public)
S3_PUBLIC_BASE_URL=http://localhost:9000/media

# --- Frontend ---
# Dev (npm run dev): http://localhost:5173
# Prod (web service trong docker-compose, nginx): http://localhost:8080
# Dùng cho redirect sau OAuth + CORS, đặt đúng cổng FE đang chạy.
FRONTEND_URL=http://localhost:5173

# --- Proxy (định tuyến outbound qua proxy) ---
# PROXY_ENABLED=false -> mọi request đi trực tiếp như cũ.
PROXY_ENABLED=false
# Có định tuyến cả việc tải media của Collector qua proxy (pool) không.
PROXY_APPLY_TO_MEDIA=true
# Endpoint echo IP dùng khi bấm "Test" proxy.
PROXY_TEST_URL=https://api.ipify.org?format=json

# --- Threads OAuth (điền sau khi tạo Meta app) ---
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/api/accounts/oauth/threads/callback
THREADS_AUTH_BASE=https://threads.net
THREADS_GRAPH_BASE=https://graph.threads.net
THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_insights,threads_keyword_search
